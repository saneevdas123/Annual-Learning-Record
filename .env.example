# ─────────────────────────────────────────────────────────────────────────────
# ALR Platform — environment
# Copy to `.env` and fill in. Only DATABASE_URL and AUTH_SECRET are required.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Local docker-compose default shown; replace with your managed DB in production
# (Neon, Supabase, RDS, etc.). Use a pooled connection string for serverless.
DATABASE_URL="postgresql://alr:alr@localhost:5432/alr?schema=public"

# Secret used to sign session JWTs. Generate a strong value, e.g.:
#   openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# First registered account automatically becomes ADMIN. These are only used by
# `npm run db:seed` to create the bootstrap admin.
SEED_ADMIN_EMAIL="admin@cutm.ac.in"
SEED_ADMIN_PASSWORD="Admin@12345"

# ── Optional: AI-assisted subject-wise scoring (advisory only; human overrides) ──
# Leave AI_PROVIDER empty to disable AI entirely — the platform is fully usable
# without it. Set to "anthropic" or "openai" and supply the matching key.
AI_PROVIDER=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
